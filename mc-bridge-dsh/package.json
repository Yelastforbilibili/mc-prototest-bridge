{
  "name": "@local/mc-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent tools that read authoritative state from a local Minecraft Paper server through the prototest-bridge HTTP plugin.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
